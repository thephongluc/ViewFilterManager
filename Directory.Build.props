<Project><PropertyGroup>
 <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
 <AssemblyVersion>$(Version).0</AssemblyVersion><FileVersion>$(Version).0</FileVersion>
 <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Deterministic>true</Deterministic>
 <RevitDir Condition="'$(RevitDir)' == ''">C:\Program Files\Autodesk\Revit 2026</RevitDir>
</PropertyGroup></Project>