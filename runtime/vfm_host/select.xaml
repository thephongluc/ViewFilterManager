<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="700" Height="600" MinWidth="450" MinHeight="350" WindowStartupLocation="CenterOwner" Background="#F0F0F0"><DockPanel Margin="12"><TextBox x:Name="search" DockPanel.Dock="Top" TextChanged="search_changed" Padding="5" Margin="0,0,0,8"/><DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Cancel" Click="cancel_click" Padding="12,5" Margin="3"/><Button x:Name="accept" Content="Select" Click="ok_click" Padding="12,5" Margin="3"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="Check All" Click="all_click" Padding="12,5" Margin="3"/><Button Content="Check None" Click="none_click" Padding="12,5" Margin="3"/></StackPanel></DockPanel><ListBox x:Name="items"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked,Mode=TwoWay}" PreviewMouseLeftButtonDown="row_click" Padding="4"><TextBlock Text="{Binding Label}"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Window>