<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Filter Manager | Edit filter" Width="1050" Height="710" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4"/></Style>
    <HierarchicalDataTemplate x:Key="RuleNode" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}" Margin="3"/></HierarchicalDataTemplate>
    <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style>
  </Window.Resources>
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Filter name" FontWeight="SemiBold"/><TextBox x:Name="filter_name"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="Choose categories" Click="categories_click"/><TextBlock x:Name="categories_label" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="Select a group to add rules inside it. Select a rule to replace or remove it. AND requires every child; OR requires any child." TextWrapping="Wrap" Foreground="#53667A" Margin="0,10"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="editor_status" TextWrapping="Wrap" Foreground="#53667A"/>
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancel" Click="cancel_click"/><Button Content="Save filter" Click="save_click"/></StackPanel></DockPanel>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,15,0">
        <WrapPanel DockPanel.Dock="Bottom"><Button Content="Add AND group" Click="and_click"/><Button Content="Add OR group" Click="or_click"/><Button Content="Remove selected" Click="remove_node_click"/><Button Content="Clear rules" Click="clear_click"/></WrapPanel>
        <TreeView x:Name="rule_tree" ItemTemplate="{StaticResource RuleNode}"/>
      </DockPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Rule parameter" FontWeight="SemiBold"/>
        <TextBox x:Name="parameter_search" TextChanged="parameter_search_changed" ToolTip="Search available parameter names"/>
        <ComboBox x:Name="parameters" DisplayMemberPath="Label" MinHeight="32" SelectionChanged="parameter_changed"/>
        <TextBlock Text="Operator" Margin="0,12,0,4"/><ComboBox x:Name="operators" MinHeight="32"/>
        <TextBlock Text="Value" Margin="0,12,0,0"/><TextBox x:Name="value"/>
        <TextBlock x:Name="value_hint" TextWrapping="Wrap" Foreground="#53667A" Margin="0,5"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="Add rule" Click="add_rule_click"/><Button Content="Replace selected rule" Click="replace_rule_click"/></WrapPanel>
        <TextBlock Text="Categories-only filters are allowed when no rules are present. Existing rule groups retain their nesting and inversion." TextWrapping="Wrap" Foreground="#53667A" Margin="0,20,0,0"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
