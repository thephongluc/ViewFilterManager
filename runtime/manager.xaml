<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="View Filter Manager 2.0.0 | TPT" Width="1360" Height="840" MinWidth="1130" MinHeight="740" FontSize="12" Background="#F0F0F0" WindowStartupLocation="CenterOwner">
 <Window.Resources><DataTemplate x:Key="LiteralLabel"><TextBlock Text="{Binding}"/></DataTemplate>
  <Style TargetType="Button"><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="25"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="25"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/></Style>
  <HierarchicalDataTemplate x:Key="CheckTree" ItemsSource="{Binding Children}"><CheckBox PreviewMouseLeftButtonDown="check_mouse_down" Content="{Binding Label}" ContentTemplate="{StaticResource LiteralLabel}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Background="{Binding Background}" Padding="2,1"/></HierarchicalDataTemplate>
  <DataTemplate x:Key="CheckList"><CheckBox PreviewMouseLeftButtonDown="check_mouse_down" Content="{Binding Label}" ContentTemplate="{StaticResource LiteralLabel}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" Padding="1"/></DataTemplate>
 </Window.Resources>
 <DockPanel Margin="7">
  <Menu DockPanel.Dock="Top" Margin="0,0,0,6">
   <MenuItem Header="_Edit"><MenuItem Header="Create parameter filter..." Click="create_click"/><MenuItem Header="Edit rules / categories..." Click="edit_click"/><MenuItem Header="Rename..." Click="rename_click"/><MenuItem Header="Batch Rename..." Click="batch_rename_click"/><MenuItem Header="Duplicate..." Click="duplicate_click"/><MenuItem Header="Edit selection members..." Click="selection_click"/><Separator/><MenuItem Header="Remove checked filters from views..." Click="remove_click"/><MenuItem Header="Purge checked unused filters..." Click="purge_click"/></MenuItem>
   <MenuItem Header="E_xplore"><MenuItem Header="Inspect checked filters / parameters..." Click="inspect_click"/><MenuItem Header="Report missing categories..." Click="coverage_click"/><Separator/><MenuItem Header="All filters" Click="explore_all_click"/><MenuItem Header="Unused filters" Click="explore_unused_click"/><MenuItem Header="Empty rule filters" Click="explore_empty_click"/><Separator/><MenuItem Header="Export library CSV..." Click="export_csv_click"/><MenuItem Header="Export library JSON..." Click="export_json_click"/></MenuItem>
   <MenuItem Header="_View Filter Manager"><MenuItem Header="Transfer to projects..." Click="open_transfer_click"/><Separator/><MenuItem Header="Import checked filter list..." Click="import_list_click"/><MenuItem Header="Save checked filter list..." Click="save_list_click"/><MenuItem Header="Save copy preset..." Click="save_preset_click"/><MenuItem Header="Load copy preset..." Click="load_preset_click"/><Separator/><MenuItem Header="View last report..." Click="last_report_click"/><MenuItem Header="Save last report..." Click="save_report_click"/><MenuItem Header="Refresh project" Click="refresh_click"/></MenuItem>
   <MenuItem Header="_Help"><MenuItem Header="Workflow and controls..." Click="help_click"/></MenuItem>
  </Menu>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,5,0,0"><Button DockPanel.Dock="Right" Content="Close" Click="close_click"/><TextBlock x:Name="status_label" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="225" MinWidth="175"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1*" MinWidth="230"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.02*" MinWidth="245"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.08*" MinWidth="250"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.RowSpan="2" Margin="0,0,7,0"><Grid.RowDefinitions><RowDefinition Height="245"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <GroupBox Header="Select view types in a list" Padding="5" Margin="0,0,0,6"><DockPanel><UniformGrid DockPanel.Dock="Bottom" Columns="2"><Button Content="Check All" Click="types_all_click"/><Button Content="Check None" Click="types_none_click"/></UniformGrid><ListBox x:Name="view_types" SelectionMode="Extended" ItemTemplate="{StaticResource CheckList}" SelectionChanged="types_changed"/></DockPanel></GroupBox>
    <GroupBox Grid.Row="1" Header="3. Select filter overrides to copy" Padding="5"><DockPanel><UniformGrid DockPanel.Dock="Bottom" Columns="2"><Button Content="Check All" Click="overrides_all_click"/><Button Content="Check None" Click="overrides_none_click"/></UniformGrid><ListBox x:Name="override_options" SelectionMode="Extended" ItemTemplate="{StaticResource CheckList}"/></DockPanel></GroupBox>
   </Grid>
   <StackPanel Grid.Column="2" Grid.ColumnSpan="5" Margin="0,0,0,7"><TextBlock Text="1. Select source view / view template (template-controlled views use their controlling template)"/><DockPanel Margin="0,3,0,0"><ComboBox DockPanel.Dock="Left" x:Name="source_kind" Width="140" SelectionChanged="source_scope_changed" Margin="0,0,4,0"/><TextBox DockPanel.Dock="Right" x:Name="source_search" Width="175" Margin="5,0,0,0" ToolTip="Search source names" TextChanged="source_scope_changed"/><ComboBox x:Name="source_views" DisplayMemberPath="Label" SelectionChanged="source_changed"/></DockPanel></StackPanel>
   <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,7,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,5"><TextBlock Text="2. Select source filters in a view / template to copy"/><RadioButton x:Name="sort_alpha" Content="Sorting: alphabetical" GroupName="Sorting" Checked="sort_alpha_click"/><RadioButton x:Name="sort_vg" Content="Sorting: by Visibility/Graphics in view / template" IsChecked="True" GroupName="Sorting" Checked="sort_vg_click"/><DockPanel><Button DockPanel.Dock="Right" Content="Import" Click="import_list_click"/><RadioButton x:Name="sort_imported" Content="Sorting: by imported / custom list" GroupName="Sorting" Checked="sort_imported_click" VerticalAlignment="Center"/></DockPanel><Button Content="Save list of checked filters" Click="save_list_click" HorizontalAlignment="Right"/></StackPanel>
    <ListBox Grid.Row="1" x:Name="source_filters" SelectionMode="Extended" ItemTemplate="{StaticResource CheckList}" SelectionChanged="source_checks_changed"/>
    <StackPanel Grid.Row="2"><UniformGrid Columns="2"><Button Content="Check All" Click="source_all_click"/><Button Content="Move Up" Click="up_click"/><Button Content="Check None" Click="source_none_click"/><Button Content="Move Down" Click="down_click"/></UniformGrid><TextBlock x:Name="source_count" Margin="3"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Grid.Column="4" Margin="0,0,7,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <GroupBox Header="5. Reordering / placement of filters" Padding="4" Margin="0,0,0,6"><StackPanel><CheckBox x:Name="reorder" Content="Reorder filters (otherwise append missing at end)" Margin="0,2"/><ComboBox x:Name="placement" IsEnabled="{Binding IsChecked, ElementName=reorder}" Margin="0,3"/><DockPanel><TextBlock Text="Start at position" VerticalAlignment="Center"/><TextBox x:Name="position" Text="1" Width="45" Margin="6,0" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=reorder}"/></DockPanel></StackPanel></GroupBox>
    <StackPanel Grid.Row="1" Margin="0,0,0,4"><TextBlock Text="Edit, explore filters / project parameters"/><RadioButton x:Name="explore_filters" Content="Show filters in project (applied to listed views / templates)" GroupName="Explorer" IsChecked="True" Checked="explorer_mode_changed"/><RadioButton x:Name="explore_parameters" Content="Show project parameters" GroupName="Explorer" Checked="explorer_mode_changed"/><TextBox x:Name="library_search" ToolTip="Search filter or parameter names" TextChanged="explorer_search_changed"/></StackPanel>
    <Border Grid.Row="2" x:Name="explorer_border" BorderThickness="2" BorderBrush="Transparent"><TreeView x:Name="library_filters" ItemTemplate="{StaticResource CheckTree}" SelectedItemChanged="explorer_selection_changed"/></Border>
    <StackPanel Grid.Row="3"><UniformGrid Columns="2"><Button Content="Check All" Click="library_all_click"/><Button Content="Expand All" Click="library_expand_click"/><Button Content="Check None" Click="library_none_click"/><Button Content="Collapse All" Click="library_collapse_click"/></UniformGrid><TextBlock x:Name="library_count" Margin="3"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Grid.Column="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <GroupBox Header="6. Copy" Padding="4" Margin="0,0,0,6"><DockPanel><StackPanel DockPanel.Dock="Right"><Button Content="Copy" Click="copy_click" MinWidth="130"/><Button Content="Preview" Click="preview_click"/></StackPanel><StackPanel><CheckBox x:Name="copy_filters_flag" Content="Filters"/><CheckBox x:Name="copy_overrides_flag" Content="Overrides" IsChecked="True"/></StackPanel></DockPanel></GroupBox>
    <StackPanel Grid.Row="1" Margin="0,0,0,4"><TextBlock Text="4. Select destination views / view templates"/><RadioButton x:Name="dest_by_view" Content="Views / view templates" GroupName="Destination" IsChecked="True" Checked="destination_mode_changed"/><RadioButton x:Name="dest_by_filter" Content="Filters of source view / view template" GroupName="Destination" Checked="destination_mode_changed"/><DockPanel><ComboBox DockPanel.Dock="Left" x:Name="dest_kind" Width="140" SelectionChanged="destination_mode_changed" Margin="0,0,4,0"/><TextBox x:Name="dest_search" ToolTip="Search destination names" TextChanged="destination_mode_changed"/></DockPanel></StackPanel>
    <Border Grid.Row="2" BorderBrush="#E0D800" BorderThickness="3"><TreeView x:Name="dest_views" ItemTemplate="{StaticResource CheckTree}"/></Border>
    <StackPanel Grid.Row="3"><UniformGrid Columns="2"><Button Content="Check All" Click="dest_all_click"/><Button Content="Expand All" Click="dest_expand_click"/><Button Content="Check None" Click="dest_none_click"/><Button Content="Collapse All" Click="dest_collapse_click"/></UniformGrid><TextBlock x:Name="dest_count" Margin="3"/></StackPanel>
   </Grid>
<GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D0D0D0" ShowsPreview="True" ToolTip="Drag to resize columns"/><GridSplitter Grid.Column="3" Grid.Row="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D0D0D0" ShowsPreview="True" ToolTip="Drag to resize columns"/><GridSplitter Grid.Column="5" Grid.Row="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D0D0D0" ShowsPreview="True" ToolTip="Drag to resize columns"/>
   <TextBox x:Name="library_details" Visibility="Collapsed"/>
  </Grid>
 </DockPanel>
</Window>
