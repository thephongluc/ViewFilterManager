<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="View Filter Manager - Transfer" Width="1000" Height="690" MinWidth="850" MinHeight="570" Background="#F0F0F0" WindowStartupLocation="CenterOwner" FontSize="12">
 <Window.Resources><DataTemplate x:Key="LiteralLabel"><TextBlock Text="{Binding}"/></DataTemplate><Style TargetType="Button"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="7,3"/></Style><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/></Style><HierarchicalDataTemplate x:Key="CheckTree" ItemsSource="{Binding Children}"><CheckBox PreviewMouseLeftButtonDown="check_mouse_down" Content="{Binding Label}" ContentTemplate="{StaticResource LiteralLabel}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Padding="1"/></HierarchicalDataTemplate><DataTemplate x:Key="CheckList"><CheckBox PreviewMouseLeftButtonDown="check_mouse_down" Content="{Binding Label}" ContentTemplate="{StaticResource LiteralLabel}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/></DataTemplate></Window.Resources>
 <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,12,6"><TextBlock Text="Elements"/><ComboBox x:Name="source_project" DisplayMemberPath="Label" SelectionChanged="source_changed" MinHeight="26" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="Projects (check one or more destinations)" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
  <TreeView Grid.Row="1" x:Name="elements" ItemTemplate="{StaticResource CheckTree}" Margin="0,0,12,0"/><ListBox Grid.Row="1" Grid.Column="2" x:Name="projects" ItemTemplate="{StaticResource CheckList}" SelectionMode="Extended"/>
  <StackPanel Grid.Row="2" Margin="0,5,12,0"><UniformGrid Columns="3"><Button Content="Check All" Click="all_click"/><Button Content="Expand All" Click="expand_click"/><Button Content="Transfer" Click="transfer_click"/><Button Content="Check None" Click="none_click"/><Button Content="Collapse All" Click="collapse_click"/><Button Content="Preview" Click="preview_click"/></UniformGrid></StackPanel>
  <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,5,0,0"><UniformGrid Columns="2"><Button Content="Check All Projects" Click="projects_all_click"/><Button Content="Check None" Click="projects_none_click"/></UniformGrid><ComboBox x:Name="conflict" MinHeight="26" Margin="2,4"/></StackPanel>
  <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D0D0D0" ShowsPreview="True" ToolTip="Drag to resize columns"/>
  <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Close" Click="close_click"/><TextBlock x:Name="transfer_status" Text="Shared parameters map by GUID. Project parameters require matching name, data type and binding." TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
