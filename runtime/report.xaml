 <DockPanel Margin="12"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Save report..." Click="save_click" Padding="10,4" Margin="3"/><Button Content="Close" Click="close_click" Padding="10,4" Margin="3"/></StackPanel><TextBox x:Name="report_text" Foreground="Blue" FontFamily="Segoe UI" FontSize="15" BorderThickness="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel>
</Window>
